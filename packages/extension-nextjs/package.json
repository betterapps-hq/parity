{
  "name": "@parity-app/extension-nextjs",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Next.js in Parity: the app's routes from the App Router and the Pages Router, each page drawn on canvas.",
  "main": "src/extension.ts",
  "exports": {
    ".": "./src/extension.ts",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "next": "^16.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "parity": {
    "displayName": "Next.js",
    "prefix": "nextjs",
    "icon": {
      "viewBox": "0 0 24 24",
      "path": "M18.665 21.978C16.758 23.255 14.465 24 12 24 5.377 24 0 18.623 0 12S5.377 0 12 0s12 5.377 12 12c0 3.583-1.574 6.801-4.067 9.001L9.219 7.2H7.2v9.596h1.615V9.251l9.85 12.727Zm-3.332-8.533 1.6 2.061V7.2h-1.6v6.245Z"
    },
    "activates": [
      "onDetect"
    ],
    "permissions": {
      "read": [
        "app",
        "app/**",
        "pages",
        "pages/**",
        "src/app",
        "src/app/**",
        "src/pages",
        "src/pages/**",
        "next.config.*"
      ]
    },
    "contributes": {
      "commands": [
        {
          "id": "nextjs.open",
          "title": "Open in browser"
        },
        {
          "id": "nextjs.showRoutes",
          "title": "Show routes",
          "icon": "layers"
        }
      ],
      "menus": {
        "layers": [
          {
            "command": "nextjs.open",
            "when": "node.type == route"
          }
        ],
        "canvas": [
          {
            "command": "nextjs.open",
            "when": "node.type == route"
          }
        ],
        "selectionHeading": [
          {
            "command": "nextjs.open",
            "when": "node.type == route"
          }
        ],
        "search": [
          {
            "command": "nextjs.open",
            "when": "node.type == route"
          }
        ]
      },
      "statusItems": [
        {
          "id": "nextjs.routes",
          "title": "Next.js",
          "command": "nextjs.showRoutes"
        }
      ],
      "nodeTypes": [
        {
          "id": "route",
          "name": "Route",
          "icon": "route"
        }
      ],
      "providers": {
        "router": {}
      }
    }
  },
  "dependencies": {
    "@parity-app/extension": "workspace:*"
  }
}
