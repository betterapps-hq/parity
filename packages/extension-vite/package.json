{
  "name": "@parity-app/extension-vite",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Vite in Parity: the project’s own Vite and config serve its components to the canvas.",
  "main": "src/extension.ts",
  "exports": {
    ".": "./src/extension.ts",
    "./builder": "./src/builder.ts",
    "./dependency-maps": "./src/dependency-maps.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@parity-app/code": "workspace:*",
    "@parity-app/core": "workspace:*",
    "@parity-app/extension": "workspace:*",
    "@parity-app/project": "workspace:*"
  },
  "devDependencies": {
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "parity": {
    "displayName": "Vite",
    "prefix": "vite",
    "icon": {
      "viewBox": "0 0 24 24",
      "path": "M13.056 23.238a.57.57 0 0 1-1.02-.355v-5.202c0-.63-.512-1.143-1.144-1.143H5.148a.57.57 0 0 1-.464-.903l3.777-5.29c.54-.753 0-1.804-.93-1.804H.57a.574.574 0 0 1-.543-.746.6.6 0 0 1 .08-.157L5.008.78a.57.57 0 0 1 .467-.24h14.589a.57.57 0 0 1 .466.903l-3.778 5.29c-.54.755 0 1.806.93 1.806h5.745c.238 0 .424.138.513.322a.56.56 0 0 1-.063.603z",
      "color": {
        "light": "#9135FF",
        "dark": "#A95CFF"
      }
    },
    "versions": {
      "distributions": {
        "@voidzero-dev/vite-plus-core": "Vite+"
      }
    },
    "activates": [
      "onDetect"
    ],
    "contributes": {
      "statusItems": [
        {
          "id": "vite.status",
          "title": "Vite"
        }
      ],
      "providers": {
        "builder": {
          "entry": "./builder",
          "watches": [
            "vite.config.ts",
            "vite.config.mts",
            "vite.config.cts",
            "vite.config.js",
            "vite.config.mjs",
            "vite.config.cjs"
          ],
          "console": {
            "chatter": [
              "^\\[vite\\]"
            ],
            "generatedPaths": [
              "^@"
            ]
          }
        }
      }
    }
  }
}
