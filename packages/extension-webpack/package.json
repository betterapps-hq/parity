{
  "name": "@parity-app/extension-webpack",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "webpack in Parity: the project’s own webpack and config build its components for the canvas.",
  "main": "src/extension.ts",
  "exports": {
    ".": "./src/extension.ts",
    "./builder": "./src/builder.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@parity-app/builder-webpack-compatible": "workspace:*",
    "@parity-app/core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@parity-app/extension-api": "workspace:*",
    "@parity-app/extensions": "workspace:*"
  },
  "peerDependencies": {
    "webpack": "^5.90.0"
  },
  "peerDependenciesMeta": {
    "webpack": {
      "optional": true
    }
  },
  "parity": {
    "displayName": "webpack",
    "prefix": "webpack",
    "icon": {
      "viewBox": "0 0 24 24",
      "path": "M12 1.5 21.5 7v10L12 22.5 2.5 17V7zm0 2.3L4.5 8.1v7.8L12 20.2l7.5-4.3V8.1zM12 7l4.5 2.6v4.8L12 17l-4.5-2.6V9.6z"
    },
    "activates": [
      "onDetect"
    ],
    "contributes": {
      "statusItems": [
        {
          "id": "webpack.status",
          "title": "webpack"
        }
      ],
      "providers": {
        "builder": {
          "entry": "./builder",
          "watches": [
            "webpack.config.ts",
            "webpack.config.mts",
            "webpack.config.cts",
            "webpack.config.js",
            "webpack.config.mjs",
            "webpack.config.cjs",
            "rspack.config.ts",
            "rspack.config.mts",
            "rspack.config.cts",
            "rspack.config.js",
            "rspack.config.mjs",
            "rspack.config.cjs",
            "rsbuild.config.ts",
            "rsbuild.config.mts",
            "rsbuild.config.cts",
            "rsbuild.config.js",
            "rsbuild.config.mjs",
            "rsbuild.config.cjs",
            "next.config.js",
            "next.config.mjs",
            "next.config.ts",
            "next.config.mts"
          ]
        }
      }
    }
  }
}
