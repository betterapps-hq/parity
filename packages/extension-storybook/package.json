{
  "name": "@parity-app/extension-storybook",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Storybook in Parity: stories as screens, written back on Save, Open in Storybook, how many components have stories, the Stories tab and a setup guide.",
  "main": "src/extension.ts",
  "exports": {
    ".": "./src/extension.ts",
    "./screens": "./src/screens.ts",
    "./storybook": "./src/storybook.ts",
    "./views": "./src/views.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@parity-app/core": "workspace:*",
    "@parity-app/extension": "workspace:*",
    "@parity-app/project": "workspace:*",
    "typescript": "6.0.3",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "storybook": "^9.0.0 || ^10.0.0",
    "@storybook/react": "^9.0.0 || ^10.0.0",
    "@storybook/react-vite": "^9.0.0 || ^10.0.0"
  },
  "peerDependenciesMeta": {
    "storybook": {
      "optional": true
    },
    "@storybook/react": {
      "optional": true
    },
    "@storybook/react-vite": {
      "optional": true
    }
  },
  "parity": {
    "displayName": "Storybook",
    "prefix": "storybook",
    "icon": {
      "viewBox": "0 0 24 24",
      "path": "M16.71.243l-.12 2.71a.18.18 0 00.29.15l1.06-.8.9.7a.18.18 0 00.28-.14l-.1-2.76 1.33-.1a1.2 1.2 0 011.279 1.2v21.596a1.2 1.2 0 01-1.26 1.2l-16.096-.72a1.2 1.2 0 01-1.15-1.16l-.75-19.797a1.2 1.2 0 011.13-1.27L16.7.222zM13.64 9.3c0 .47 3.16.24 3.59-.08 0-3.2-1.72-4.89-4.859-4.89-3.15 0-4.899 1.72-4.899 4.29 0 4.45 5.999 4.53 5.999 6.959 0 .7-.32 1.1-1.05 1.1-.96 0-1.35-.49-1.3-2.16 0-.36-3.649-.48-3.769 0-.27 4.03 2.23 5.2 5.099 5.2 2.79 0 4.969-1.49 4.969-4.18 0-4.77-6.099-4.64-6.099-6.999 0-.97.72-1.1 1.13-1.1.45 0 1.25.07 1.19 1.87z",
      "color": {
        "light": "#FF4785",
        "dark": "#FF4785"
      }
    },
    "versions": {
      "scope": "@storybook/"
    },
    "activates": [
      "onDetect"
    ],
    "detect": {
      "entities": true
    },
    "permissions": {
      "processes": [
        "bin:storybook"
      ]
    },
    "contributes": {
      "commands": [
        {
          "id": "storybook.open",
          "title": "Open in Storybook",
          "icon": "book-open",
          "starts": "Starting Storybook…"
        },
        {
          "id": "storybook.setup",
          "title": "Show Storybook setup",
          "icon": "list-checks"
        }
      ],
      "menus": {
        "componentCard": [
          {
            "command": "storybook.open",
            "enablement": "storybook.hasStories",
            "disabledReason": "No story found"
          }
        ],
        "selectionHeading": [
          {
            "command": "storybook.open",
            "enablement": "storybook.hasStories",
            "disabledReason": "No story found"
          }
        ],
        "layers": [
          {
            "command": "storybook.open",
            "enablement": "storybook.hasStories",
            "disabledReason": "No story found"
          }
        ],
        "canvas": [
          {
            "command": "storybook.open",
            "enablement": "storybook.hasStories",
            "disabledReason": "No story found"
          }
        ],
        "search": [
          {
            "command": "storybook.open"
          },
          {
            "command": "storybook.setup"
          }
        ]
      },
      "tabs": [
        {
          "id": "storybook.stories",
          "area": "left",
          "title": "Stories",
          "icon": "book-open",
          "view": "tree"
        }
      ],
      "sections": [
        {
          "id": "storybook.componentStories",
          "title": "Stories",
          "nodeType": "component",
          "when": "storybook.hasStories",
          "view": "list"
        }
      ],
      "pages": [
        {
          "id": "storybook.setupGuide",
          "title": "Storybook setup",
          "icon": "list-checks",
          "view": "list"
        }
      ],
      "settings": {
        "storybook.configDir": {
          "type": "string",
          "default": ".storybook",
          "scope": "project",
          "title": "Config folder"
        },
        "storybook.openIn": {
          "type": "string",
          "enum": [
            "browser",
            "parity"
          ],
          "enumTitles": [
            "Your browser",
            "Parity's browser"
          ],
          "default": "browser",
          "scope": "app",
          "title": "Open stories in"
        }
      },
      "statusItems": [
        {
          "id": "storybook.stories",
          "title": "Storybook",
          "label": "in Storybook",
          "command": "storybook.open"
        }
      ],
      "providers": {
        "preview": {
          "files": [
            ".storybook/preview.tsx",
            ".storybook/preview.ts",
            ".storybook/preview.jsx",
            ".storybook/preview.js",
            ".storybook/preview.mjs"
          ],
          "compose": {
            "api": "portable-stories",
            "from": [
              "@storybook/react",
              "@storybook/react-vite",
              "@storybook/nextjs",
              "@storybook/nextjs-vite",
              "@storybook/react-webpack5"
            ]
          }
        },
        "entities": {
          "watches": [
            ".storybook/main.ts",
            ".storybook/main.mts",
            ".storybook/main.cts",
            ".storybook/main.js",
            ".storybook/main.mjs",
            ".storybook/main.cjs"
          ],
          "group": "Stories",
          "states": {
            "one": "story",
            "many": "stories"
          },
          "color": {
            "light": "oklch(0.6 0.1 195)",
            "dark": "oklch(0.8 0.12 190)"
          }
        }
      }
    }
  }
}
