{
  "name": "@parity-app/cli",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Drive the Parity app from a terminal or an agent: read state, run edits, take screenshots, serve MCP.",
  "keywords": [
    "parity",
    "design",
    "components",
    "mcp",
    "cli"
  ],
  "homepage": "https://github.com/betterapps-hq/parity/tree/main/packages/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/betterapps-hq/parity.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/betterapps-hq/parity/issues",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "parity": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/client.ts"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "vp pack",
    "prepack": "vp pack",
    "try-packed": "node scripts/try-packed.ts"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "parity": "./dist/bin.mjs"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "dependencies": {
    "semver": "^7.8.5",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@parity-app/core": "workspace:*",
    "@parity-app/libgen": "workspace:*",
    "@parity-app/registry": "workspace:*"
  }
}
