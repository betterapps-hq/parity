{
  "name": "@parity-app/extension",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "What an extension is written against: its types, defineExtension, the manifest check its tests run, and helpers for writing stylesheets.",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/reader/index.ts",
    "./internal": "./src/internal.ts",
    "./page": "./src/page.ts",
    "./styles": "./src/styles.ts"
  },
  "dependencies": {
    "@parity-app/core": "workspace:*",
    "@parity-app/style-schema": "workspace:*",
    "@parity-app/tokens": "workspace:*",
    "zod": "catalog:"
  }
}
