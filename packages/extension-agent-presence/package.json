{
  "name": "@parity-app/extension-agent-presence",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Agents at work on the canvas: a pointer per agent that travels to what it reads or changes, scans it and drags the boards it moves.",
  "exports": {
    ".": "./src/index.ts",
    "./window": "./src/window.tsx",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@parity-app/canvas-layer": "workspace:*",
    "@parity-app/extension": "workspace:*",
    "@parity-app/presence-ui": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1"
  },
  "parity": {
    "displayName": "Agent presence",
    "prefix": "agentPresence",
    "icon": {
      "viewBox": "0 0 24 24",
      "path": "M4.2 3.1C3.5 2.8 2.8 3.5 3.1 4.2L9.4 19.6C9.7 20.4 10.8 20.3 11 19.5L12.6 13.4C12.7 13 13 12.7 13.4 12.6L19.5 11C20.3 10.8 20.4 9.7 19.6 9.4Z"
    },
    "internal": true,
    "window": "./window",
    "detect": {
      "always": true
    },
    "activates": [
      "onSetting:agentPresence.show"
    ],
    "capabilities": [
      "canvas",
      "agents",
      "hold"
    ],
    "contributes": {
      "settings": {
        "agentPresence.show": {
          "type": "boolean",
          "default": true,
          "scope": "app",
          "title": "Show agents on canvas"
        }
      }
    }
  }
}
