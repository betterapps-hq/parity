{
  "name": "@parity-app/extension-tailwind",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Tailwind CSS in Parity: the theme as tokens, layers written as classes, and token edits saved into @theme.",
  "main": "src/extension.ts",
  "exports": {
    ".": "./src/extension.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@parity-app/core": "workspace:*",
    "@parity-app/extension": "workspace:*",
    "@parity-app/project": "workspace:*",
    "@parity-app/style-schema": "workspace:*",
    "@parity-app/tokens": "workspace:*"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "parity": {
    "displayName": "Tailwind CSS",
    "prefix": "tailwind",
    "icon": {
      "viewBox": "0 0 24 24",
      "path": "M12.001,4.8c-3.2,0-5.2,1.6-6,4.8c1.2-1.6,2.6-2.2,4.2-1.8c0.913,0.228,1.565,0.89,2.288,1.624 C13.666,10.618,15.027,12,18.001,12c3.2,0,5.2-1.6,6-4.8c-1.2,1.6-2.6,2.2-4.2,1.8c-0.913-0.228-1.565-0.89-2.288-1.624 C16.337,6.182,14.976,4.8,12.001,4.8z M6.001,12c-3.2,0-5.2,1.6-6,4.8c1.2-1.6,2.6-2.2,4.2-1.8c0.913,0.228,1.565,0.89,2.288,1.624 c1.177,1.194,2.538,2.576,5.512,2.576c3.2,0,5.2-1.6,6-4.8c-1.2,1.6-2.6,2.2-4.2,1.8c-0.913-0.228-1.565-0.89-2.288-1.624 C10.337,13.382,8.976,12,6.001,12z",
      "color": {
        "light": "#0891B2",
        "dark": "#38BDF8"
      }
    },
    "versions": {
      "prefix": "v"
    },
    "activates": [
      "onDetect"
    ],
    "contributes": {
      "commands": [
        {
          "id": "tailwind.showTokens",
          "title": "Show tokens",
          "icon": "palette"
        }
      ],
      "statusItems": [
        {
          "id": "tailwind.status",
          "title": "Tailwind CSS",
          "command": "tailwind.showTokens"
        }
      ],
      "providers": {
        "styles": {}
      }
    }
  }
}
