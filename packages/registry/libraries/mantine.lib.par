{
  "version": 3,
  "id": "mantine",
  "name": "Mantine",
  "description": "A full-featured component library with CSS modules and its own hooks.",
  "package": {
    "name": "@mantine/core",
    "version": "9.7.3",
    "range": "^9.0.0"
  },
  "styles": "styles.css",
  "breakpoints": [
    {
      "id": "xs",
      "name": "Extra small",
      "width": 576
    },
    {
      "id": "sm",
      "name": "Small",
      "width": 768
    },
    {
      "id": "md",
      "name": "Medium",
      "width": 992
    },
    {
      "id": "lg",
      "name": "Large",
      "width": 1200
    },
    {
      "id": "xl",
      "name": "XL",
      "width": 1408
    }
  ],
  "tokens": {
    "version": "2025.10",
    "sets": {
      "tokens": {
        "sources": [
          {
            "other": {
              "z": {
                "index": {
                  "app": {
                    "$type": "number",
                    "$value": 100,
                    "$extensions": {
                      "parity": {
                        "var": "mantine-z-index-app"
                      }
                    }
                  },
                  "modal": {
                    "$type": "number",
                    "$value": 200,
                    "$extensions": {
                      "parity": {
                        "var": "mantine-z-index-modal"
                      }
                    }
                  },
                  "popover": {
                    "$type": "number",
                    "$value": 300,
                    "$extensions": {
                      "parity": {
                        "var": "mantine-z-index-popover"
                      }
                    }
                  },
                  "overlay": {
                    "$type": "number",
                    "$value": 400,
                    "$extensions": {
                      "parity": {
                        "var": "mantine-z-index-overlay"
                      }
                    }
                  },
                  "max": {
                    "$type": "number",
                    "$value": 9999,
                    "$extensions": {
                      "parity": {
                        "var": "mantine-z-index-max"
                      }
                    }
                  }
                }
              },
              "scale": {
                "$type": "number",
                "$value": 1,
                "$extensions": {
                  "parity": {
                    "var": "mantine-scale"
                  }
                }
              },
              "cursor": {
                "type": {
                  "$value": "default",
                  "$extensions": {
                    "parity": {
                      "var": "mantine-cursor-type"
                    }
                  }
                }
              },
              "heading": {
                "text": {
                  "wrap": {
                    "$value": "wrap",
                    "$extensions": {
                      "parity": {
                        "var": "mantine-heading-text-wrap"
                      }
                    }
                  }
                }
              },
              "input": {
                "bd": {
                  "$value": "transparent",
                  "$extensions": {
                    "parity": {
                      "var": "input-bd"
                    }
                  },
                  "focus": {
                    "$value": "transparent",
                    "$extensions": {
                      "parity": {
                        "var": "input-bd-focus"
                      }
                    }
                  }
                },
                "bg": {
                  "$value": "transparent",
                  "$extensions": {
                    "parity": {
                      "var": "input-bg"
                    }
                  }
                }
              },
              "alpha": {
                "overlay": {
                  "bg": {
                    "$value": "{color.white}",
                    "$extensions": {
                      "parity": {
                        "var": "alpha-overlay-bg"
                      }
                    }
                  }
                }
              },
              "slider": {
                "checkers": {
                  "$value": "{color.gray.3}",
                  "$extensions": {
                    "parity": {
                      "var": "slider-checkers"
                    }
                  }
                },
                "track": {
                  "bg": {
                    "$value": "{color.gray.2}",
                    "$extensions": {
                      "parity": {
                        "var": "slider-track-bg"
                      }
                    }
                  }
                }
              },
              "empty": {
                "state": {
                  "indicator": {
                    "default": {
                      "bg": {
                        "$value": "{color.gray.1}",
                        "$extensions": {
                          "parity": {
                            "var": "empty-state-indicator-default-bg"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "switch": {
                "bg": {
                  "$value": "{color.gray.3}",
                  "$extensions": {
                    "parity": {
                      "var": "switch-bg"
                    }
                  }
                },
                "thumb": {
                  "bg": {
                    "disabled": {
                      "$value": "{color.gray.0}",
                      "$extensions": {
                        "parity": {
                          "var": "switch-thumb-bg-disabled"
                        }
                      }
                    }
                  }
                }
              },
              "details": {
                "summary": {
                  "hover": {
                    "$value": "{color.gray.1}",
                    "$extensions": {
                      "parity": {
                        "var": "details-summary-hover"
                      }
                    }
                  }
                }
              }
            },
            "font": {
              "webkit": {
                "font": {
                  "smoothing": {
                    "$value": "antialiased",
                    "$extensions": {
                      "parity": {
                        "var": "mantine-webkit-font-smoothing"
                      }
                    }
                  }
                }
              },
              "moz": {
                "font": {
                  "smoothing": {
                    "$value": "grayscale",
                    "$extensions": {
                      "parity": {
                        "var": "mantine-moz-font-smoothing"
                      }
                    }
                  }
                }
              },
              "font": {
                "family": {
                  "$value": "-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif,\n    Apple Color Emoji, Segoe UI Emoji",
                  "$extensions": {
                    "parity": {
                      "var": "mantine-font-family"
                    }
                  }
                }
              },
              "monospace": {
                "$value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New, monospace",
                "$extensions": {
                  "parity": {
                    "var": "mantine-font-family-monospace"
                  }
                }
              },
              "headings": {
                "$value": "-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif,\n    Apple Color Emoji, Segoe UI Emoji",
                "$extensions": {
                  "parity": {
                    "var": "mantine-font-family-headings"
                  }
                }
              }
            },
            "color": {
              "white": {
                "$type": "color",
