{
  "version": 3,
  "id": "hugeicons",
  "name": "Hugeicons",
  "description": "Thousands of free icons as data, drawn by Hugeicons' React component.",
  "package": {
    "name": "@hugeicons/core-free-icons",
    "version": "4.3.5",
    "range": "^4.0.0"
  },
  "icons": {
    "render": {
      "import": "@hugeicons/react",
      "component": "HugeiconsIcon",
      "prop": "icon"
    },
    "match": "Icon$",
    "count": 6025
  }
}
