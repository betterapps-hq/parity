{
  "name": "parity",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "pnpm --filter @parity-app/desktop dev",
    "dev:prod": "pnpm --filter @parity-app/desktop dev:prod",
    "build": "pnpm --filter @parity-app/desktop build",
    "inspect": "pnpm --filter @parity-app/desktop inspect",
    "perf": "pnpm --filter @parity-app/desktop perf",
    "storybook": "pnpm --filter @parity-app/desktop storybook",
    "format": "vp fmt",
    "check:types": "vp run types",
    "check:unused": "knip",
    "test:app": "vp test run --config apps/desktop/e2e/vite.config.ts",
    "verify": "vp run check && vp run test",
    "changefile": "node scripts/changes.ts write",
    "prepare": "vp config --hooks --no-agent",
    "guidance:sync": "playbook-sync",
    "guidance:check": "playbook-sync --check",
    "guidance:update": "pnpm update @betterapps/playbook --latest && playbook-sync",
    "skills:add": "skills add",
    "skills:update": "skills update -p",
    "skills:remove": "skills remove",
    "skills:check": "skills check",
    "skills:sync": "skills add betterapps-hq/playbook --skill \"*\" -a codex claude-code github-copilot --yes",
    "rules:import": "rulesync import"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "beachball": "catalog:",
    "knip": "catalog:",
    "typescript": "7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "@betterapps/playbook": "github:betterapps-hq/playbook",
    "rulesync": "43.5.0",
    "skills": "1.7.6"
  }
}
