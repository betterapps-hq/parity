{
  "version": 4,
  "containers": [],
  "modes": {
    "version": 1,
    "variables": [
      {
        "id": "viewport",
        "name": "Viewport",
        "kind": "viewport",
        "options": [
          {
            "id": "desktop",
            "name": "Desktop",
            "width": 1280
          },
          {
            "id": "tablet",
            "name": "Tablet",
            "width": 768
          },
          {
            "id": "mobile",
            "name": "Mobile",
            "width": 390
          }
        ]
      },
      {
        "id": "theme",
        "name": "Theme",
        "kind": "theme",
        "options": [
          {
            "id": "light",
            "name": "Light"
          },
          {
            "id": "dark",
            "name": "Dark",
            "className": "dark"
          }
        ]
      },
      {
        "id": "locale",
        "name": "Locale",
        "kind": "locale",
        "options": [
          {
            "id": "en",
            "name": "English",
            "attributes": {
              "lang": "en",
              "dir": "ltr"
            }
          },
          {
            "id": "ar",
            "name": "Arabic (RTL)",
            "attributes": {
              "lang": "ar",
              "dir": "rtl"
            }
          }
        ]
      }
    ],
    "modes": [
      {
        "id": "desktop-light",
        "name": "Desktop Light",
        "values": {
          "viewport": "desktop",
          "theme": "light"
        }
      },
      {
        "id": "desktop-dark",
        "name": "Desktop Dark",
        "values": {
          "viewport": "desktop",
          "theme": "dark",
          "locale": "en"
        }
      },
      {
        "id": "tablet-light",
        "name": "Tablet Light",
        "values": {
          "viewport": "tablet",
          "theme": "light"
        }
      },
      {
        "id": "mobile-light",
        "name": "Mobile Light",
        "values": {
          "viewport": "mobile",
          "theme": "light"
        }
      }
    ]
  }
}
