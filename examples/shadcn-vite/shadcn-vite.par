              "width": 52
            },
            "type": "component",
            "component": "Button",
            "props": {
              "children": "Save changes",
              "className": "w-full sm:w-auto",
              "variant": "destructive"
            }
          }
        ]
      },
      "states": [
        {
          "id": "default",
          "name": "Default"
        },
        {
          "id": "outline",
          "name": "Outline",
          "overrides": {
            "button": {
              "props": {
                "variant": "outline",
                "children": "Cancel"
              }
            }
          }
        },
        {
          "id": "destructive",
          "name": "Destructive",
          "overrides": {
            "button": {
              "props": {
                "variant": "destructive",
                "children": "Delete project"
              }
            }
          }
        },
        {
          "id": "disabled",
          "name": "Disabled",
          "overrides": {
            "button": {
              "props": {
                "disabled": true,
                "children": "Saving…"
              }
            }
          }
        }
      ],
      "view": {
        "modes": [],
        "state": "default",
        "allStates": true
      }
    },
