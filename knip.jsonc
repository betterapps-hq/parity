// Unused files, dependencies and exports, found by `pnpm check:unused` (PAR-395). Each workspace names what starts its
// code; knip follows imports from there. The example project and fixtures/ stand in for customers' projects, so they're
// left out: fixtures/ isn't a workspace, and the example project is ignored below.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreWorkspaces": ["examples/*"],
  "workspaces": {
    ".": {
      // scripts/*.ts are what `pnpm changefile` and the hooks in .vite-hooks run. The root vite.config.ts comes from
      // knip's Vite and Vitest plugins.
      "entry": ["scripts/*.ts", "beachball.config.cjs"],
      "project": ["scripts/**/*.ts", "*.{ts,cjs}"]
    },
    "apps/desktop": {
      "entry": [
        // The processes scripts/dev.ts bundles: main, the windows' preload scripts, and the project service with its
        // workers.
        "src/main/index.ts",
        "src/preload/{index,render}.ts",
        "src/utility/{index,props-worker,builder-process,extension-host}.ts",
        // The renderer's pages, index.html and render.html, load these.
        "src/renderer/{main.tsx,render.ts}",
        // What the package's scripts and the docs run: dev, inspect, perf, drive, snap and icons.
        "scripts/*.ts",
        ".storybook/{main,preview}.ts",
        "src/**/*.stories.tsx",
        "src/**/*.test.ts",
        ".storybook/*.test.ts",
        // The end-to-end tests `pnpm test:app` runs, with the config and setup that start the app for them, and the
        // setup file that sends a failed test's replay.
        "e2e/*.e2e.ts",
        "e2e/{vite.config,global-setup,failed-replay}.ts"
      ],
      // CSS too, so its imports of tailwindcss, the kit's stylesheet and Geist count as uses.
      "project": ["src/**/*.{ts,tsx,css}", "scripts/**/*.ts", ".storybook/*.ts", "e2e/**/*.ts", "*.ts"],
      "ignoreDependencies": [
        // Imported by @parity-app/project, which scripts/dev.ts bundles while leaving these out, so the bundled processes
        // load them from the app's own node_modules.
        "package-manager-detector",
        "semver",
        "unconfig",
        // Imported by @parity-app/style-schema the same way, to match a CSS value against its property's grammar.
        "css-tree",
        // Buildkit's Storybook config adds these addons by path, from its own dependencies; knip's Storybook plugin
        // counts them as the app's.
        "@storybook/addon-a11y",
        "@storybook/addon-vitest"
      ],
      // macOS's own commands: plutil and sips name and brand the dev Electron, top reads memory.
      "ignoreBinaries": ["plutil", "sips", "top"],
      "ignoreIssues": {
        // Design explorations drawn in Storybook. Their shared parts and sample data are a kit for stories still being
        // drawn.
        "src/renderer/explorations/**": ["exports"]
      }
    },
    "packages/cli": {
      // The bin comes from package.json, and knip's Vite plugin finds vite.config.ts, the `vp pack` config.
      // scripts/try-packed.ts tries the packed CLI.
      "entry": ["src/**/*.test.ts", "scripts/*.ts", "src/send.ts"]
    },
    "packages/libgen": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      // A demo library's type declarations, which libgen.test.ts reads by path.
      "ignore": ["src/fixtures/**"]
    },
    "packages/extension-storybook": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      // Resolved from the project's own node_modules, to start the Storybook it has installed.
      "ignoreDependencies": ["storybook"]
    },
    "packages/extension-api": {
      // Types only: its exports come from package.json, and it has no tests.
      "entry": [],
      "project": ["src/**/*.ts"]
    },
    "packages/*": {
      // Each package's exports and scripts come from its package.json.
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
