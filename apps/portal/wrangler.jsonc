// The Worker's config. infra/cloudflare makes each environment's Worker, its domain and where it's served; a deploy
// uploads the code and owns the bindings here. Top level is production; `CLOUDFLARE_ENV=staging` builds staging's.
// Bindings and vars aren't inherited, so staging and its previews repeat them.
//
// The sources' keys are Worker secrets, set by the app's owner with `wrangler secret put` and kept across deploys:
// PARITY_MOBBIN_API_KEY and PARITY_PIXABAY_API_KEY. A source without one isn't searched.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parity-portal",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Production is served at api.tryparity.dev only, as infra/cloudflare says.
  "workers_dev": false,
  "preview_urls": false,
  // Parity's client in WorkOS, which is public: the service checks each access token against its keys.
  "vars": { "WORKOS_CLIENT_ID": "client_01M6Q30XB58AF2CEHTE79ACMWS" },
  // Searches' answers, kept for a day and shared by everyone (PAR-131). A deploy makes the namespace when it's missing.
  "kv_namespaces": [{ "binding": "SEARCH_CACHE" }],
  // Each counts in one Cloudflare location over a minute, which is enough to stop a loop: a person's searches, requests
  // that name nobody from one address, and each source's searches, kept under the 60 a minute Mobbin allows its key.
  "ratelimits": [
    { "name": "PEOPLE", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "ADDRESSES", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "SOURCES", "namespace_id": "1003", "simple": { "limit": 50, "period": 60 } }
  ],
  "env": {
    "staging": {
      "name": "parity-portal-staging",
      "workers_dev": true,
      "preview_urls": true,
      "vars": { "WORKOS_CLIENT_ID": "client_01M6Q30XB58AF2CEHTE79ACMWS" },
      "kv_namespaces": [{ "binding": "SEARCH_CACHE" }],
      "ratelimits": [
        { "name": "PEOPLE", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
        { "name": "ADDRESSES", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
        { "name": "SOURCES", "namespace_id": "2003", "simple": { "limit": 50, "period": 60 } }
      ],
      // A pull request's preview is a preview of staging's Worker, with staging's bindings.
      "previews": {
        "vars": { "WORKOS_CLIENT_ID": "client_01M6Q30XB58AF2CEHTE79ACMWS" },
        "kv_namespaces": [{ "binding": "SEARCH_CACHE" }],
        "ratelimits": [
          { "name": "PEOPLE", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
          { "name": "ADDRESSES", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
          { "name": "SOURCES", "namespace_id": "2003", "simple": { "limit": 50, "period": 60 } }
        ]
      }
    }
  }
}
