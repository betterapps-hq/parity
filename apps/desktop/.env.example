# Copy to .env.local, which Git ignores, and fill in.

# tldraw's license key. Without one, tldraw shows a "Get a license for production" notice on the canvas. A free
# 100-day trial key from https://tldraw.dev/pricing removes it until the paid license is in place.
VITE_TLDRAW_LICENSE_KEY=

# A Mobbin API key, from Mobbin's Settings > API keys on a Team or Enterprise plan (PAR-829). `pnpm dev` passes it to the
# main process, which searches Mobbin with it; it never reaches the window or the project service.
PARITY_MOBBIN_API_KEY=

# An Unsplash Access Key, from your app at https://unsplash.com/oauth/applications with Public access only; the Secret
# Key isn't needed. `pnpm dev` passes it to the main process alone, as with Mobbin's.
PARITY_UNSPLASH_ACCESS_KEY=
