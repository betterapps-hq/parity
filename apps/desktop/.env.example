# Copy to .env.local, which Git ignores, and fill in.

# tldraw's license key. Without one, tldraw shows a "Get a license for production" notice on the canvas. A free
# 100-day trial key from https://tldraw.dev/pricing removes it until the paid license is in place.
VITE_TLDRAW_LICENSE_KEY=

# Connectors' keys are the app owner's, never a person's (PAR-829). Main reads them once, then takes them out of its
# environment, so they never reach the window, the project service or anything it starts.

# Parity's Mobbin API key, from Mobbin's Settings > API keys on a Team or Enterprise plan. `pnpm dev` passes it to the
# main process, which searches Mobbin with it.
PARITY_MOBBIN_API_KEY=

# Parity's Pixabay API key, shown at https://pixabay.com/api/docs/ once signed in to Parity's Pixabay account. Pixabay
# finds photos, illustrations, vectors and videos. `pnpm dev` passes it to the main process alone, as with Mobbin's.
PARITY_PIXABAY_API_KEY=

# The Access Key of Parity's app at https://unsplash.com/oauth/applications, with Public access only; the Secret Key isn't
# needed. Unsplash's connector is kept but not offered, since Pixabay finds photos instead, so this is only for trying it.
PARITY_UNSPLASH_ACCESS_KEY=
